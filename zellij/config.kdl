// Free up Ctrl-n / Ctrl-p / Ctrl-b so terminal apps (nvim completion, fzf/fzf-lua
// result navigation, etc.) receive them directly instead of zellij intercepting
// them to switch modes. The same actions are still reachable, just on Alt instead.
keybinds {
    unbind "Ctrl n"
    unbind "Ctrl p"
    unbind "Ctrl b"

    shared_except "resize" "locked" {
        bind "Alt n" { SwitchToMode "Resize"; }
    }
    resize {
        bind "Alt n" { SwitchToMode "Normal"; }
    }

    shared_except "pane" "locked" {
        bind "Alt p" { SwitchToMode "Pane"; }
    }

    shared_except "tmux" "locked" {
        bind "Alt b" { SwitchToMode "Tmux"; }
    }
}
