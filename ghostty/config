# Fonts
font-family = 
font-thicken = true
grapheme-width-method = unicode

# Theme
# theme = "Atelier Sulphurpool"
theme = "Iceberg Dark"

# Background
background-opacity = 1
unfocused-split-opacity = 0.8

# Command
command = $HOME/.nix-profile/bin/fish

# Keybinds

keybind = ctrl+shift+j=write_scrollback_file:open
window-decoration = true

# Shell Integration

shell-integration-features = "sudo,ssh-terminfo,ssh-env"

custom-shader = /users/misaelaguayo/.config/ghostty/shaders/debug_cursor_animated.glsl
